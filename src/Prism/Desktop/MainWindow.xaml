<Window x:Class="Prism.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Prism.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Icon="pack://application:,,,/Prism;component/Assets/prism.ico" Title="Prism — CIPHER 26" Width="1500" Height="970" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_KeyDown" AllowDrop="True" Drop="Window_Drop" Closing="Window_Closing">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#45434D" BorderThickness="1">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="49"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
  <!-- Native title area and application menu. -->
  <Border Grid.Row="0" Background="#242529" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Title_Drag">
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,0,0">
     <local:Glyph Kind="prism" Width="26" Height="26" Color="{StaticResource Accent}"/>
     <TextBlock Text="prism" FontSize="23" FontWeight="SemiBold" Margin="9,-3,23,0"/>
     <Button Content="File" Click="Menu_Click" Tag="file" Padding="9,8"/><Button Content="Edit" Click="Menu_Click" Tag="edit" Padding="9,8"/><Button Content="Image" Click="Menu_Click" Tag="image" Padding="9,8"/><Button Content="Layer" Click="Menu_Click" Tag="layer" Padding="9,8"/><Button Content="Select" Click="Menu_Click" Tag="select" Padding="9,8"/><Button Content="View" Click="Menu_Click" Tag="view" Padding="9,8"/><Button Content="Help" Click="Help_Click" Padding="9,8"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <TextBlock x:Name="TitleDocument" Text="CIPHER 26" Foreground="#B9B8C3" FontSize="12" Margin="0,0,9,0"/>
     <Button x:Name="LicenseBadge" Content="Activate Prism" Click="License_Click" Background="#34313F" Padding="9,5" FontSize="11" Foreground="#D7C5FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <Button Width="43" Click="Minimize_Click" ToolTip="Minimize"><local:Glyph Kind="minus" Width="14" Height="14"/></Button>
     <Button Width="43" Click="Maximize_Click" ToolTip="Maximize or restore"><local:Glyph Kind="shape" Width="12" Height="12"/></Button>
     <Button Width="43" Click="Close_Click" ToolTip="Close Prism"><local:Glyph Kind="close" Width="17" Height="17"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <!-- Options change with the active tool. -->
  <Border Grid.Row="1" Background="#292A2F" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <Grid Margin="15,0,15,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <local:Glyph x:Name="ActiveToolIcon" Kind="move"/>
     <TextBlock x:Name="ActiveToolName" Text="Move" Margin="10,0,17,0" FontWeight="SemiBold"/>
     <Border Width="1" Height="23" Background="#43434C" Margin="0,0,17,0"/>
     <StackPanel x:Name="MoveOptions" Orientation="Horizontal">
      <CheckBox x:Name="AutoSelect" Content="Auto-select" IsChecked="True" VerticalAlignment="Center" Margin="0,0,17,0"/>
      <CheckBox x:Name="TransformControls" Content="Transform controls" IsChecked="True" VerticalAlignment="Center" Checked="Transform_Toggled" Unchecked="Transform_Toggled"/>
      <Border Width="1" Height="23" Background="#43434C" Margin="19,0,12,0"/>
      <Button Style="{StaticResource IconButton}" ToolTip="Align left" Tag="left" Click="Align_Click"><local:Glyph Kind="align-left" Width="17" Height="17"/></Button>
      <Button Style="{StaticResource IconButton}" ToolTip="Align center" Tag="center" Click="Align_Click"><local:Glyph Kind="align-center" Width="17" Height="17"/></Button>
      <Button Style="{StaticResource IconButton}" ToolTip="Align right" Tag="right" Click="Align_Click"><local:Glyph Kind="align-right" Width="17" Height="17"/></Button>
     </StackPanel>
     <StackPanel x:Name="BrushOptions" Orientation="Horizontal" Visibility="Collapsed">
      <TextBlock Text="Size" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/><Slider x:Name="BrushSize" Width="120" Minimum="2" Maximum="250" Value="24"/><TextBlock x:Name="BrushSizeLabel" Text="24 px" Width="49" Margin="12,0,0,0"/><TextBlock Text="Round · hard edge" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
     </StackPanel>
     <TextBlock x:Name="ToolInstruction" Text="Click and drag on the canvas" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"><local:Glyph Kind="undo" Width="17" Height="17"/></Button>
     <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Shift+Z)"><local:Glyph Kind="redo" Width="17" Height="17"/></Button>
     <Border Width="1" Height="21" Background="#43434C" Margin="11,0,16,0"/>
     <Button Style="{StaticResource PrimaryButton}" Click="Export_Click" Padding="12,7"><StackPanel Orientation="Horizontal"><local:Glyph Kind="export" Color="#241C35" Width="15" Height="15" Margin="0,0,8,0"/><TextBlock Text="Export" Foreground="#241C35" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="⌄" Foreground="#55446F" Margin="13,-3,0,0"/></StackPanel></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="4"/><ColumnDefinition x:Name="SidebarColumn" Width="304" MinWidth="276" MaxWidth="400"/></Grid.ColumnDefinitions>
   <!-- Compact tool rail. -->
   <Border Background="#242529" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,13">
      <Button Style="{StaticResource ToolButton}" Click="Help_Click" ToolTip="Keyboard shortcuts"><local:Glyph Kind="help" Width="18" Height="18" Color="#8F909D"/></Button>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ToolRail" HorizontalAlignment="Center" Margin="0,9,0,0">
       <Button Style="{StaticResource ToolButton}" Tag="move" Click="Tool_Click" ToolTip="Move tool (V)"><local:Glyph Kind="move"/></Button>
       <Button Style="{StaticResource ToolButton}" Tag="select" Click="Tool_Click" ToolTip="Rectangle selection (M)"><local:Glyph Kind="select"/></Button>
       <Button Style="{StaticResource ToolButton}" Tag="crop" Click="Tool_Click" ToolTip="Crop tool (C)"><local:Glyph Kind="crop"/></Button>
       <Border Height="1" Background="#3C3D44" Margin="7,10"/>
       <Button Style="{StaticResource ToolButton}" Tag="brush" Click="Tool_Click" ToolTip="Brush tool (B)"><local:Glyph Kind="brush"/></Button>
       <Button Style="{StaticResource ToolButton}" Tag="eraser" Click="Tool_Click" ToolTip="Eraser (E)"><local:Glyph Kind="eraser"/></Button>
       <Button Style="{StaticResource ToolButton}" Tag="dropper" Click="Tool_Click" ToolTip="Eyedropper (I)"><local:Glyph Kind="dropper"/></Button>
       <Border Height="1" Background="#3C3D44" Margin="7,10"/>
       <Button Style="{StaticResource ToolButton}" Tag="text" Click="Tool_Click" ToolTip="Text tool (T)"><local:Glyph Kind="text"/></Button>
       <Button Style="{StaticResource ToolButton}" Tag="shape" Click="Tool_Click" ToolTip="Rectangle tool (U)"><local:Glyph Kind="shape"/></Button>
       <Border Height="1" Background="#3C3D44" Margin="7,10"/>
       <Button Style="{StaticResource ToolButton}" Tag="hand" Click="Tool_Click" ToolTip="Hand tool (H) · Hold Space to pan"><local:Glyph Kind="hand"/></Button>
       <Button Style="{StaticResource ToolButton}" Tag="zoom" Click="Tool_Click" ToolTip="Zoom tool (Z) · Alt+click to zoom out"><local:Glyph Kind="zoom"/></Button>
       <Border Height="1" Background="#3C3D44" Margin="7,10"/>
       <Button Padding="0" Width="39" Height="42" Click="Color_Click" ToolTip="Foreground color"><Grid Width="36" Height="36"><Border Background="#F2F0F6" Width="23" Height="23" BorderBrush="#242529" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/><Border x:Name="ForegroundSwatch" Background="#B8A4FF" Width="25" Height="25" BorderBrush="#242529" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid></Button>
       <TextBlock Text="D" FontSize="10" Foreground="#757681" HorizontalAlignment="Center" Margin="0,2,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <!-- Document workspace. -->
   <Grid Grid.Column="1" Background="#1A1B1F">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="21"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#222327" BorderBrush="#34353B" BorderThickness="0,0,0,1">
     <DockPanel LastChildFill="False">
      <Border DockPanel.Dock="Left" Background="#303036" BorderBrush="{StaticResource Accent}" BorderThickness="0,2,0,0" Padding="17,0,12,0">
       <StackPanel Orientation="Horizontal"><local:Glyph Kind="image" Width="15" Height="15" Color="#B9A7EC"/><TextBlock x:Name="TabName" Text="CIPHER 26" Margin="9,0,13,0" FontSize="12"/><TextBlock x:Name="TabZoom" Text="55%" FontSize="11" Foreground="#A8A6B3"/><TextBlock Text="(RGB/8)" FontSize="10" Foreground="#85838F" Margin="7,0,13,0"/><Button Style="{StaticResource IconButton}" Click="New_Click" ToolTip="Close document and start a new one" Width="23"><local:Glyph Kind="close" Width="13" Height="13"/></Button></StackPanel>
      </Border>
      <Button DockPanel.Dock="Left" Width="38" Click="New_Click" ToolTip="New document (Ctrl+N)"><local:Glyph Kind="plus" Width="16" Height="16" Color="#93919E"/></Button>
      <Button DockPanel.Dock="Right" Width="38" Click="Open_Click" ToolTip="Open image or Prism document (Ctrl+O)"><local:Glyph Kind="folder" Width="15" Height="15" Color="#93919E"/></Button>
     </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="#242529" BorderBrush="#34353B" BorderThickness="0,0,0,1"><local:Ruler x:Name="HorizontalRuler"/></Border>
    <Grid Grid.Row="2" x:Name="CanvasArea" SizeChanged="CanvasArea_SizeChanged">
     <Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#242529" BorderBrush="#34353B" BorderThickness="0,0,1,0"><local:Ruler x:Name="VerticalRuler" Vertical="True"/></Border>
     <ScrollViewer x:Name="CanvasScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Canvas_MouseWheel" PreviewMouseLeftButtonDown="Workspace_MouseDown" PreviewMouseMove="Workspace_MouseMove" PreviewMouseLeftButtonUp="Workspace_MouseUp">
      <Grid x:Name="CanvasHost" Margin="38,28,38,65" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Background="#101014"><Border.Effect><DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.32"/></Border.Effect><local:DocumentSurface x:Name="Surface" MouseLeftButtonDown="Surface_MouseDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseUp"/></Border>
      </Grid>
     </ScrollViewer>
     <Border Grid.Column="1" x:Name="ContextBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22" Background="#2B2B31" BorderBrush="#45434E" BorderThickness="1" CornerRadius="8" Padding="5">
      <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25"/></Border.Effect>
      <StackPanel Orientation="Horizontal">
       <Button Click="EditLayer_Click" Padding="10,7"><StackPanel Orientation="Horizontal"><local:Glyph x:Name="ContextIcon" Kind="text" Width="15" Height="15" Color="#C4B3F3"/><TextBlock x:Name="ContextLabel" Text="Edit text" Margin="9,0,4,0" FontSize="12"/></StackPanel></Button>
       <Border Width="1" Height="20" Background="#47454F" Margin="6,0"/>
       <Button Click="Duplicate_Click" ToolTip="Duplicate layer (Ctrl+J)" Padding="10,7"><StackPanel Orientation="Horizontal"><local:Glyph Kind="duplicate" Width="14" Height="14"/><TextBlock Text="Duplicate" FontSize="12" Margin="8,0,4,0"/></StackPanel></Button>
       <Button Style="{StaticResource IconButton}" Click="LayerMenu_Click" ToolTip="Layer actions"><local:Glyph Kind="more" Width="20" Height="20"/></Button>
      </StackPanel>
     </Border>
    </Grid>
    <Grid Grid.Row="3" Background="#222327" Margin="0">
     <TextBlock x:Name="CanvasSizeLabel" Text="1500 × 1050 px" FontSize="11" Foreground="#92929D" Margin="16,0"/>
     <TextBlock Text="sRGB IEC61966-2.1  ·  8-bit" FontSize="10" Foreground="#777884" HorizontalAlignment="Right" Margin="0,0,15,0"/>
    </Grid>
   </Grid>
   <GridSplitter Grid.Column="2" Background="#18191D" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"/>
   <!-- Resizable inspector: navigator, properties, layers and history. -->
   <Grid Grid.Column="3" Background="{StaticResource Panel}">
    <Grid.RowDefinitions><RowDefinition Height="171" MinHeight="125" MaxHeight="250"/><RowDefinition Height="4"/><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="4"/><RowDefinition Height="1.1*" MinHeight="210"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="15,0">
     <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
     <TextBlock Text="Navigator" FontWeight="SemiBold" FontSize="12"/><Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Fit_Click" ToolTip="Fit canvas to workspace"><local:Glyph Kind="expand" Width="14" Height="14" Color="#92929D"/></Button>
     <Border Grid.Row="1" Background="#17181C" BorderBrush="#4C445F" BorderThickness="1"><Grid x:Name="NavigatorMap" Cursor="Hand" MouseLeftButtonDown="Navigator_MouseDown" MouseMove="Navigator_MouseMove" MouseLeftButtonUp="Navigator_MouseUp" SizeChanged="Navigator_SizeChanged" ToolTip="Click or drag to navigate the canvas"><Image x:Name="NavigatorImage" Stretch="Uniform" Margin="2"/><Canvas IsHitTestVisible="False" ClipToBounds="True"><Rectangle x:Name="NavigatorViewport" Stroke="#C4ACFF" StrokeThickness="1" Fill="#13B8A4FF"/></Canvas></Grid></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="29"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ZoomLabel" Text="55%" FontSize="11" Foreground="#BEBDC8"/>
      <Button Grid.Column="1" Width="25" Padding="5" Click="ZoomOut_Click" ToolTip="Zoom out"><local:Glyph Kind="minus" Width="13" Height="13"/></Button>
      <Slider Grid.Column="2" x:Name="ZoomSlider" Minimum="1" Maximum="400" Value="55" Margin="6,0" ValueChanged="Zoom_Changed"/>
      <Button Grid.Column="3" Width="25" Padding="5" Click="ZoomIn_Click" ToolTip="Zoom in"><local:Glyph Kind="plus" Width="13" Height="13"/></Button>
      <Button Grid.Column="4" Width="29" Padding="5" Click="Fit_Click" ToolTip="Fit (Ctrl+0)"><local:Glyph Kind="expand" Width="13" Height="13"/></Button>
     </Grid>
    </Grid>
    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#191A1E" ResizeDirection="Rows"/>
    <Grid Grid.Row="2">
     <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="#383940" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" Margin="7,0,0,0"><Button x:Name="PropertiesTab" Content="Properties" Click="Properties_Click" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12" Padding="9,9"/><Button x:Name="AdjustmentsTab" Content="Adjustments" Click="Adjustments_Click" Foreground="{StaticResource Muted}" FontSize="12" Padding="9,9"/></StackPanel></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
       <StackPanel x:Name="EmptyInspector" Visibility="Collapsed" Margin="20,22"><local:Glyph Kind="layers" Width="26" Height="26" Color="#93869F" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="Select a layer" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Choose a layer on the canvas or in the Layers panel to edit its properties." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
       <StackPanel x:Name="PropertiesPanel" Margin="16,14,16,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Border Background="#36303F" CornerRadius="4" Padding="6"><local:Glyph x:Name="PropertyIcon" Kind="text" Width="14" Height="14" Color="{StaticResource Accent}"/></Border><TextBlock x:Name="PropertyKind" Text="Type layer" Margin="10,0,0,0" FontSize="12" Foreground="#B7B5C1"/></StackPanel>
        <Grid Margin="0,0,0,10"><TextBlock Text="Transform" FontWeight="SemiBold" FontSize="12"/><local:Glyph Kind="chevron" HorizontalAlignment="Right" Width="12" Height="12"/></Grid>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="XField" Text="87" Padding="28,6,7,6" LostKeyboardFocus="TransformField_Changed" KeyDown="PropertyField_KeyDown"/><TextBlock Text="X" Margin="10,0,0,0" Foreground="#85838F" FontSize="11" IsHitTestVisible="False"/></Grid><Grid Grid.Column="2"><TextBox x:Name="YField" Text="130" Padding="28,6,7,6" LostKeyboardFocus="TransformField_Changed" KeyDown="PropertyField_KeyDown"/><TextBlock Text="Y" Margin="10,0,0,0" Foreground="#85838F" FontSize="11" IsHitTestVisible="False"/></Grid></Grid>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="WidthField" Text="1250" Padding="28,6,7,6" LostKeyboardFocus="TransformField_Changed" KeyDown="PropertyField_KeyDown"/><TextBlock Text="W" Margin="10,0,0,0" Foreground="#85838F" FontSize="11" IsHitTestVisible="False"/></Grid><Grid Grid.Column="2"><TextBox x:Name="HeightField" Text="279" Padding="28,6,7,6" LostKeyboardFocus="TransformField_Changed" KeyDown="PropertyField_KeyDown"/><TextBlock Text="H" Margin="10,0,0,0" Foreground="#85838F" FontSize="11" IsHitTestVisible="False"/></Grid></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="RotationField" Text="0" Padding="29,6,7,6" LostKeyboardFocus="TransformField_Changed" KeyDown="PropertyField_KeyDown"/><local:Glyph Kind="rotate" Width="13" Height="13" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"/></Grid><TextBlock Grid.Column="2" Text="px" Foreground="#7E7D89" FontSize="11" Margin="2,0,0,0"/></Grid>
        <Border Height="1" Background="#383940" Margin="0,14,0,12"/>
        <StackPanel x:Name="CharacterPanel">
         <TextBlock Text="Character" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
         <ComboBox x:Name="FontSelect" SelectedIndex="0" SelectionChanged="Font_Changed" Margin="0,0,0,7"><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Bahnschrift"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Georgia"/><ComboBoxItem Content="Consolas"/></ComboBox>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="WeightSelect" SelectedIndex="1" SelectionChanged="Font_Changed"><ComboBoxItem Content="Regular"/><ComboBoxItem Content="Bold"/></ComboBox><TextBox x:Name="FontSizeField" Grid.Column="2" Text="137" LostKeyboardFocus="FontSize_Changed" KeyDown="PropertyField_KeyDown"/></Grid>
         <Grid Margin="0,10,0,0"><TextBlock Text="Color" FontSize="12" Foreground="{StaticResource Muted}"/><Button x:Name="LayerColorButton" HorizontalAlignment="Right" Click="LayerColor_Click" Padding="7,3"><StackPanel Orientation="Horizontal"><Border x:Name="LayerColorSwatch" Width="14" Height="14" Background="#F8F7F2" CornerRadius="2" Margin="0,0,8,0"/><TextBlock x:Name="LayerColorText" Text="F8F7F2" FontSize="11"/></StackPanel></Button></Grid>
        </StackPanel>
        <Button x:Name="GeneralColorButton" Content="Change layer color" Click="LayerColor_Click" Background="#33313D" Visibility="Collapsed"/>
       </StackPanel>
       <StackPanel x:Name="AdjustmentsPanel" Visibility="Collapsed" Margin="16,16">
        <TextBlock Text="Image adjustments" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Applied to the selected image layer." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <Button Click="Adjustment_Click" Tag="brighten" Background="#303137" Margin="0,0,0,9" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><local:Glyph Kind="sun" Margin="0,0,12,0"/><TextBlock Text="Increase brightness"/></StackPanel></Button>
        <Button Click="Adjustment_Click" Tag="darken" Background="#303137" Margin="0,0,0,9"><StackPanel Orientation="Horizontal"><local:Glyph Kind="sun" Margin="0,0,12,0"/><TextBlock Text="Decrease brightness"/></StackPanel></Button>
        <Button Click="Adjustment_Click" Tag="contrast" Background="#303137" Margin="0,0,0,9"><StackPanel Orientation="Horizontal"><local:Glyph Kind="contrast" Margin="0,0,12,0"/><TextBlock Text="Increase contrast"/></StackPanel></Button>
        <Button Click="Adjustment_Click" Tag="grayscale" Background="#303137"><StackPanel Orientation="Horizontal"><local:Glyph Kind="contrast" Margin="0,0,12,0"/><TextBlock Text="Black &amp; white"/></StackPanel></Button>
        <TextBlock Text="Use Ctrl+Z to undo an adjustment." Foreground="#85838F" FontSize="11" Margin="0,15,0,0"/>
       </StackPanel>
      </Grid>
     </ScrollViewer>
    </Grid>
    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#191A1E" ResizeDirection="Rows"/>
    <Grid Grid.Row="4">
     <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="41"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
     <Border BorderBrush="#383940" BorderThickness="0,0,0,1"><Grid><StackPanel Orientation="Horizontal" Margin="7,0,0,0"><Button x:Name="LayersTab" Content="Layers" Click="Layers_Click" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12" Padding="9,9"/><Button x:Name="HistoryTab" Content="History" Click="History_Click" Foreground="{StaticResource Muted}" FontSize="12" Padding="9,9"/></StackPanel><Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,8,0" Click="LayerMenu_Click" ToolTip="Layer actions"><local:Glyph Kind="more" Width="18" Height="18"/></Button></Grid></Border>
     <Grid x:Name="LayerOptions" Grid.Row="1" Margin="13,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="60"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><Border Background="#2D2E34" BorderBrush="#393A42" BorderThickness="1" CornerRadius="4"><TextBlock Text="Normal" FontSize="11" Margin="9,0" ToolTip="Normal alpha compositing"/></Border><TextBlock Grid.Column="2" Text="Opacity" FontSize="11" Foreground="{StaticResource Muted}"/><TextBox x:Name="OpacityField" Grid.Column="3" Text="100%" FontSize="11" Padding="5,5" LostKeyboardFocus="Opacity_Changed" KeyDown="PropertyField_KeyDown"/></Grid>
     <ScrollViewer x:Name="LayersScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LayersList"/></ScrollViewer>
     <ScrollViewer x:Name="HistoryScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel x:Name="HistoryList" Margin="8,0"/></ScrollViewer>
     <Border Grid.Row="3" BorderBrush="#383940" BorderThickness="0,1,0,0"><Grid Margin="7,0"><TextBlock x:Name="LayerCount" Text="6 layers" FontSize="10" Foreground="#84838F" Margin="8,0,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource IconButton}" Click="Lock_Click" ToolTip="Lock or unlock selected layer"><local:Glyph Kind="lock" Width="14" Height="14"/></Button><Button Style="{StaticResource IconButton}" Click="Duplicate_Click" ToolTip="Duplicate layer"><local:Glyph Kind="duplicate" Width="14" Height="14"/></Button><Button Style="{StaticResource IconButton}" Click="AddLayer_Click" ToolTip="New transparent paint layer"><local:Glyph Kind="plus" Width="16" Height="16"/></Button><Button Style="{StaticResource IconButton}" Click="DeleteLayer_Click" ToolTip="Delete selected layer"><local:Glyph Kind="trash" Width="14" Height="14"/></Button></StackPanel></Grid></Border>
    </Grid>
   </Grid>
