<controls:PrismDialog x:Class="Prism.Views.LicenseWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Prism.Controls"
 Title="Prism · Subscription" Width="554" Padding="28,25,28,24">
 <controls:PrismDialog.Footer>
  <Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Ellipse x:Name="FooterDot" Width="6" Height="6" Fill="#A697BC" Margin="0,0,8,0"/>
    <TextBlock x:Name="FooterStatus" Text="Subscription &amp; devices" FontSize="12" Foreground="#A69DAF"/>
   </StackPanel>
   <Button x:Name="DoneButton" Content="Back to editor" Style="{StaticResource DialogSecondaryButton}" HorizontalAlignment="Right" Click="Done_Click" IsCancel="True"/>
  </Grid>
 </controls:PrismDialog.Footer>
 <StackPanel>
  <Grid Margin="0,0,0,9">
   <TextBlock Text="YOUR WORKSPACE" FontSize="10" Foreground="#A196AE" FontWeight="SemiBold"/>
   <Border x:Name="DevelopmentBadge" Background="#302C37" BorderBrush="#423A4B" BorderThickness="1" CornerRadius="4" Padding="7,3" HorizontalAlignment="Right"><TextBlock Text="DEVELOPMENT" FontSize="9" Foreground="#B5A5C8" FontWeight="SemiBold"/></Border>
  </Grid>
  <TextBlock x:Name="PageHeading" Text="Activate your workspace" FontSize="25" FontWeight="SemiBold" Foreground="#F2EFF7" TextWrapping="Wrap"/>
  <TextBlock x:Name="PageDescription" Text="Activate Prism to unlock your editing tools." FontSize="13" Foreground="#ABA3B7" Margin="0,9,0,22" TextWrapping="Wrap" LineHeight="20"/>
  <Border x:Name="StatusCard" Background="#2E2938" BorderBrush="#453A54" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,21">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="StatusIconBackground" Width="30" Height="30" Background="#40354F" CornerRadius="7" VerticalAlignment="Top"><controls:Glyph x:Name="StatusIcon" Kind="lock" Width="16" Height="16" Color="#C9B4F2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock x:Name="StatusTitle" Text="Ready to activate" FontSize="14" FontWeight="SemiBold" Foreground="#DDD0F3"/><TextBlock x:Name="StatusDescription" Text="Your existing files can still be viewed, saved, and exported." FontSize="12" Foreground="#B8AEC5" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel x:Name="ActivationForm">
   <TextBlock Text="License key" FontSize="13" FontWeight="SemiBold" Foreground="#D9D2E4" Margin="0,0,0,8"/>
   <Border x:Name="KeyBorder" Background="#1D1D23" BorderBrush="#595062" BorderThickness="1" CornerRadius="6" MinHeight="45">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
     <controls:Glyph Kind="lock" Width="15" Height="15" Color="#A597B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Grid Grid.Column="1" Margin="0,1">
      <PasswordBox x:Name="SecretKey" FontFamily="Consolas" FontSize="13" Foreground="#E2D9F0" CaretBrush="#C8AFF6" Background="Transparent" BorderThickness="0" Padding="0,12" PasswordChanged="Key_Changed" GotKeyboardFocus="Key_Focused" LostKeyboardFocus="Key_Unfocused" PreviewKeyDown="Key_PreviewKeyDown" AutomationProperties.Name="Subscription license key"/>
      <TextBox x:Name="VisibleKey" Visibility="Collapsed" Style="{StaticResource DialogField}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="13" Padding="0,12" TextChanged="VisibleKey_Changed" GotKeyboardFocus="Key_Focused" LostKeyboardFocus="Key_Unfocused" PreviewKeyDown="Key_PreviewKeyDown" AutomationProperties.Name="Visible subscription license key"/>
      <TextBlock x:Name="KeyPlaceholder" Text="Paste your subscription key" FontSize="13" Foreground="#81768F" IsHitTestVisible="False" VerticalAlignment="Center"/>
     </Grid>
     <Button x:Name="RevealButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" VerticalAlignment="Center" ToolTip="Show license key" AutomationProperties.Name="Show license key" Focusable="True" Click="Reveal_Click"><controls:Glyph x:Name="RevealIcon" Kind="eye" Width="15" Height="15" Color="#A99DB8"/></Button>
    </Grid>
   </Border>
   <TextBlock Text="Use the key provided with your subscription." FontSize="11" Foreground="#968BA3" Margin="0,7,0,0" TextWrapping="Wrap"/>
   <Border x:Name="FeedbackCard" Visibility="Collapsed" Background="#372A2D" BorderBrush="#694047" BorderThickness="1" CornerRadius="5" Padding="11,9" Margin="0,13,0,0"><TextBlock x:Name="FeedbackText" Foreground="#F0B8B8" FontSize="12" TextWrapping="Wrap" LineHeight="18"/></Border>
   <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Margin="0,17,0,0" Height="43" FontSize="13" Click="Activate_Click">
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="ActivateLabel" Text="Activate Prism" FontSize="13" FontWeight="SemiBold"/><controls:Glyph Kind="chevron-right" Width="15" Height="15" Color="#30223F" Margin="10,0,0,0"/></StackPanel>
   </Button>
  </StackPanel>
  <Button x:Name="RefreshButton" Style="{StaticResource DialogLinkButton}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="Refresh_Click"><StackPanel Orientation="Horizontal"><controls:Glyph Kind="rotate" Width="13" Height="13" Color="#BAA5DB" Margin="0,0,7,0"/><TextBlock x:Name="RefreshLabel" Text="Already activated? Check subscription" FontSize="12"/></StackPanel></Button>
  <Border x:Name="GeneralFeedback" Visibility="Collapsed" Background="#2D2A35" CornerRadius="5" Padding="11,9" Margin="0,10,0,0"><TextBlock x:Name="GeneralFeedbackText" Foreground="#CBC0DB" FontSize="12" TextWrapping="Wrap" LineHeight="18"/></Border>
  <Border Background="#29292F" BorderBrush="#37343F" BorderThickness="1" CornerRadius="7" Padding="15,13" Margin="0,19,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="THIS DEVICE" FontSize="10" Foreground="#93889F" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><controls:Glyph Kind="image" Width="14" Height="14" Color="#B3A7C2" Margin="0,0,8,0"/><TextBlock x:Name="DeviceNameLabel" Text="Windows PC" FontSize="13" Foreground="#E0D8E9" TextTrimming="CharacterEllipsis" MaxWidth="165"/></StackPanel></StackPanel>
    <Border Grid.Column="1" Background="#45404B" Margin="0,3"/>
    <StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="OFFLINE ACCESS" FontSize="10" Foreground="#93889F" Margin="0,0,0,6"/><TextBlock x:Name="OfflineValue" Text="Up to 7 days" FontSize="13" Foreground="#E0D8E9"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel x:Name="ActiveActions" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0"><Button Content="Use another key" Style="{StaticResource DialogLinkButton}" Click="AnotherKey_Click"/><Button x:Name="DeactivateButton" Content="Deactivate this device" Style="{StaticResource DialogLinkButton}" Click="Deactivate_Click"/></StackPanel>
  <Expander x:Name="ConnectionDetails" Header="Connection details" Style="{StaticResource DialogDisclosure}" Margin="0,9,0,0">
   <StackPanel><TextBlock Text="Licensing server" Foreground="#A397B1" FontSize="11" Margin="0,0,0,4"/><TextBlock x:Name="ServerLabel" FontFamily="Consolas" Foreground="#C8BDD7" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="Device identifier" Foreground="#A397B1" FontSize="11" Margin="0,10,0,4"/><TextBlock x:Name="DeviceIdLabel" FontFamily="Consolas" Foreground="#B9ABC9" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="LeaseLabel" Foreground="#B9ABC9" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel>
  </Expander>
  <StackPanel Orientation="Horizontal" Margin="0,11,0,0"><controls:Glyph Kind="lock" Width="12" Height="12" Color="#9587A5" Margin="0,0,8,0"/><TextBlock Text="Your documents stay on this device." FontSize="11" Foreground="#A196AE"/></StackPanel>
 </StackPanel>
</controls:PrismDialog>
