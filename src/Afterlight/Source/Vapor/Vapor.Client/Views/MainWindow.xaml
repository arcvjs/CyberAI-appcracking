<Window x:Class="Vapor.Client.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vapor" Width="1440" Height="900" MinWidth="1100" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="{StaticResource SteamPageBottom}"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Closing="OnClosing">
 <Grid Background="{StaticResource SteamPageBottom}">
  <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="62"/><RowDefinition/><RowDefinition Height="39"/></Grid.RowDefinitions>
  <Border Background="{StaticResource SteamHeader}" Padding="25,0">
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="VAPOR" Foreground="#DCDEDF" FontFamily="Segoe UI Semibold" FontSize="13"/>
     <TextBlock Text="VAPOR CLIENT" Foreground="#7C818A" FontSize="11" Margin="20,1,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Border Background="#293647" Padding="9,4"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#66C0F4" Margin="0,0,8,0"/><TextBlock x:Name="AccountLabel" Text="Not signed in" FontSize="12" Foreground="#66C0F4"/></StackPanel></Border>
     <Button x:Name="SignOutButton" Content="Sign out" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="10,4" Click="OnSignOut" Visibility="Collapsed"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="{StaticResource SteamHeader}" Padding="25,0,25,14">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
    <Button x:Name="StoreTab" Content="STORE" Click="OnStore" Style="{StaticResource NavigationButton}"/>
    <Button x:Name="LibraryTab" Content="LIBRARY" Click="OnLibrary" Style="{StaticResource NavigationButton}"/>
    <Button x:Name="CommunityTab" Content="COMMUNITY" Click="OnCommunity" Style="{StaticResource NavigationButton}"/>
   </StackPanel>
  </Border>
  <ContentControl x:Name="Shell" Grid.Row="2"/>
  <Border Grid.Row="3" Background="#202126" BorderBrush="#34363D" BorderThickness="0,1,0,0" Padding="24,10">
   <Grid><TextBlock x:Name="StatusLeft" Text="Starting Vapor..." FontSize="11" Foreground="#8F98A0"/><TextBlock x:Name="StatusRight" Text="" FontSize="11" Foreground="#8F98A0" HorizontalAlignment="Right"/></Grid>
  </Border>
 </Grid>
</Window>
