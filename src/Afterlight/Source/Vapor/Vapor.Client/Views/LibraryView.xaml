<UserControl x:Class="Vapor.Client.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition/></Grid.RowDefinitions>
  <Border Background="{StaticResource SteamHeader}" BorderBrush="#171A20" BorderThickness="0,0,0,1" Padding="30,12">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock x:Name="NavStore" Text="STORE" Style="{StaticResource NavTab}" MouseLeftButtonUp="OnNavStore"/>
    <TextBlock x:Name="NavLibrary" Text="LIBRARY" Style="{StaticResource NavTab}" MouseLeftButtonUp="OnNavLibrary"/>
    <TextBlock x:Name="NavCommunity" Text="COMMUNITY" Style="{StaticResource NavTab}" MouseLeftButtonUp="OnNavCommunity"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#202126" BorderBrush="#171A20" BorderThickness="0,0,1,0">
    <Grid Margin="0,26,0,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="HOME" FontSize="17" Foreground="#ECEFE6" FontFamily="Segoe UI Semibold" Margin="23,0,0,25"/>
      <Grid Margin="23,0,23,12"><TextBlock Text="INSTALLED" FontSize="10" Foreground="#7F99A8"/><TextBlock Text="01" HorizontalAlignment="Right" FontSize="10" Foreground="#7F99A8"/></Grid>
      <Border x:Name="GameItem" Background="#3E526B" BorderBrush="#66C0F4" BorderThickness="3,0,0,0" Padding="18,14" Cursor="Hand" MouseLeftButtonUp="OnGameClick">
       <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="44" Background="#263447"><TextBlock Text="A" FontFamily="Bahnschrift" FontSize="29" Foreground="#66C0F4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Margin="12,3,0,0"><TextBlock Text="AFTERLIGHT" FontFamily="Segoe UI Semibold" Foreground="#EDF1E9" FontSize="13"/><TextBlock x:Name="GameItemStatus" Text="Checking license" FontSize="11" Foreground="#9EB8C2" Margin="0,4,0,0"/></StackPanel>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Grid.Row="2" Margin="24,0"><Border Background="#3D4450" Width="30" Height="2" HorizontalAlignment="Left" Margin="0,0,0,17"/><TextBlock Text="VAPOR CLIENT" FontSize="10" Foreground="#66C0F4"/><TextBlock Text="One game. All on this PC." FontSize="12" Foreground="#7F99A8" Margin="0,7,0,0"/></StackPanel>
    </Grid>
   </Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Grid Height="320" ClipToBounds="True">
      <Image Source="/Vapor;component/Assets/courtyard.png" Stretch="UniformToFill"/>
      <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C518202C"/><GradientStop Color="#0018202C" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00252830"/><GradientStop Color="#FF252830" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <StackPanel Margin="36,47,0,0" VerticalAlignment="Top">
       <TextBlock Text="OUTPOST 07   /   CONTAINMENT PROTOCOL" FontSize="11" Foreground="#66C0F4" FontFamily="Segoe UI Semibold"/>
       <TextBlock Text="AFTERLIGHT" FontFamily="Bahnschrift" FontSize="72" Foreground="#F1EEE1" Margin="-4,17,0,0"/>
       <TextBlock Text="The outpost is quiet. Keep it that way." FontSize="19" Foreground="#D3DED8" Margin="0,4,0,0"/>
       <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
        <Border Background="#70132731" BorderBrush="#657D84" BorderThickness="1" Padding="11,6" Margin="0,0,9,0"><TextBlock Text="FIRST-PERSON SHOOTER" Foreground="#CBDED9" FontSize="10"/></Border>
        <Border Background="#70132731" BorderBrush="#657D84" BorderThickness="1" Padding="11,6"><TextBlock Text="SINGLE PLAYER" Foreground="#CBDED9" FontSize="10"/></Border>
       </StackPanel>
      </StackPanel>
     </Grid>
     <StackPanel Margin="30,0,30,30">
      <Border Background="#303640" BorderBrush="#3A424E" BorderThickness="1" Padding="22,20">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0"><TextBlock x:Name="LicenseTitle" Text="Checking your license..." Foreground="#F1EEE1" FontFamily="Segoe UI Semibold" FontSize="19"/><TextBlock x:Name="LicenseDetail" Foreground="#A5B7C1" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel>
        <StackPanel Grid.Column="0" VerticalAlignment="Center"><Button x:Name="PlayButton" Content="PLAY" MinWidth="170" Height="54" Style="{StaticResource PrimaryButton}" FontSize="19" Click="OnPlay"/><Button x:Name="StoreLink" Content="View game details" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="OnStorePage" Visibility="Collapsed"/></StackPanel>
       </Grid>
      </Border>
      <Grid Margin="0,27,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="03" FontFamily="Bahnschrift" FontSize="34" Foreground="#ECEFE6"/><TextBlock Text="WAVES TO SURVIVE" FontSize="10" Foreground="#8DA4B0" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="21" FontFamily="Bahnschrift" FontSize="34" Foreground="#ECEFE6"/><TextBlock Text="ROGUE DRONES" FontSize="10" Foreground="#8DA4B0" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="01" FontFamily="Bahnschrift" FontSize="34" Foreground="#ECEFE6"/><TextBlock Text="PULSE CARBINE" FontSize="10" Foreground="#8DA4B0" Margin="0,4,0,0"/></StackPanel>
      </Grid>
      <Border Height="1" Background="#3D4450" Margin="0,25,0,22"/>
      <TextBlock Text="ACTIVITY" FontSize="10" Foreground="#7E9AA8"/>
      <TextBlock x:Name="ActivityText" Text="Welcome to the courtyard." FontSize="14" Foreground="#BECFD2" Margin="0,10,0,0"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>

