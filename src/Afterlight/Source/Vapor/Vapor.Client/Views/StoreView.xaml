<UserControl x:Class="Vapor.Client.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26">
            <TextBlock Text="Featured" FontFamily="Segoe UI Semibold" FontSize="22" Foreground="White" Margin="0,0,0,14"/>
            <Border Height="240" CornerRadius="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A475E" Offset="0"/>
                        <GradientStop Color="#101822" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="36,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NOW AVAILABLE" FontSize="12" Foreground="{StaticResource SteamBlue}" Margin="0,0,0,6"/>
                        <TextBlock Text="AFTERLIGHT" FontFamily="Segoe UI Black" FontSize="42" Foreground="White"/>
                        <TextBlock Text="The outpost is quiet. Keep it that way." FontSize="14" Foreground="{StaticResource SteamText}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BuyButton" Content="Buy now — $19.99" Style="{StaticResource PrimaryButton}" FontSize="16" Padding="26,10" Click="OnBuy"/>
                            <Button Content="Includes offline single player" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Simulated checkout. No payment details are required." FontSize="11" Foreground="{StaticResource SteamTextDim}" Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
