<Window x:Class="Vapor.Client.Views.TrialOverWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vapor — Afterlight" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#252830" ShowInTaskbar="False">
 <Grid Background="#252830"><Grid.RowDefinitions><RowDefinition Height="135"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ClipToBounds="True"><Image Source="/Vapor;component/Assets/courtyard.png" Stretch="UniformToFill"/><Border Background="#59162731"/><TextBlock Text="AFTERLIGHT" FontFamily="Bahnschrift" FontSize="43" Foreground="#F1EEE1" VerticalAlignment="Bottom" Margin="35,0,0,22"/></Grid>
  <StackPanel Grid.Row="1" Margin="35,27,35,30">
   <TextBlock Text="TRIAL COMPLETE" FontSize="11" Foreground="#66C0F4" FontFamily="Segoe UI Semibold"/>
   <TextBlock Text="Your trial has ended." FontFamily="Bahnschrift" FontSize="37" Foreground="#F1EEE1" Margin="0,15,0,0"/>
   <TextBlock x:Name="DetailText" Text="The courtyard will be here when you get back. Get the full game to continue playing Afterlight." FontSize="15" Foreground="#AFC0C7" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="23"/>
   <Border Background="#1B2029" BorderBrush="#3D4450" BorderThickness="1" Padding="17" Margin="0,24,0,0">
    <Grid><StackPanel><TextBlock Text="AFTERLIGHT — Full game" FontFamily="Segoe UI Semibold" Foreground="#E9EEE7" FontSize="16"/><TextBlock Text="All three waves · Offline single player" Foreground="#93AFBB" FontSize="12" Margin="0,6,0,0"/></StackPanel><TextBlock Text="$19.99" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Bahnschrift" FontSize="28" Foreground="#66C0F4"/></Grid>
   </Border>
   <Grid Margin="0,25,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="CancelButton" Content="Back to library" Style="{StaticResource SecondaryButton}" Height="50" Click="OnCancel"/>
    <Button x:Name="PurchaseButton" Grid.Column="2" Content="Purchase full game" Style="{StaticResource PrimaryButton}" Height="50" Click="OnPurchase"/>
   </Grid>
   <TextBlock x:Name="StatusText" Text="Simulated checkout. No payment will be taken." FontSize="12" Foreground="#91A6B1" Margin="0,17,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</Window>

